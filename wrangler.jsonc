/**
 * PPME Den Haag – event registration (Cloudflare Workers + React Router SSR)
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * ENVIRONMENTS (vars and d1_databases are NOT inherited, so each block repeats them):
 *   (top level)  local development: D1 is emulated by Miniflare, secrets come from `.dev.vars`
 *   test         TEMPORARY public test Worker  `ppme-registration`        on workers.dev, form only (/admin is 404)
 *   test-admin   TEMPORARY admin for the test  `ppme-registration-admin`  on workers.dev, /admin only, app login (email PIN / Google)
 *   production        `ppme-event`        public form on event.ppmedenhaag.nl (custom domain), ENABLE_ADMIN=false, cron, its own NEW clean D1 `ppme-registration-prod`
 *   production-admin  `ppme-event-admin`  admin + later the scanner on event-admin.ppmedenhaag.nl (custom domain), ENABLE_PUBLIC=false, no cron,
 *                     app login, same new D1. (Config added 13 Nov; not deployed until secrets are set.) See docs/deploy-runbook.md (Track 2) and docs/dns-migration-todo.md.
 *   test-checkin        TEMPORARY scanner app `ppme-registration-checkin` on workers.dev (/scan only), same D1 as `test`
 *   production-checkin  `ppme-event-checkin`: the D-day scanner app (/scan only) for event-checkin.ppmedenhaag.nl, same D1 as `production`.
 *                       The custom domain is attached by hand (see the block below). See docs/scanner-plan.md.
 * Admin login is the app's own (no Cloudflare Access): a 6-digit PIN by email via Resend, optionally Google sign-in
 * (set GOOGLE_CLIENT_ID below + `wrangler secret put GOOGLE_CLIENT_SECRET --env <admin env>`); sessions last 24 h.
 * Secrets are per Worker: wrangler secret put <NAME> --env <env>   (test: TURNSTILE_SECRET + RESEND_API_KEY; test-admin: TURNSTILE_SECRET + RESEND_API_KEY [+ GOOGLE_CLIENT_SECRET])
 * Feature switches (string "false" turns one off, anything else = on): ENABLE_PUBLIC (form) and ENABLE_ADMIN (/admin).
 * PUBLIC_APP_URL = origin of the PUBLIC Worker, set in every env (also the admin one): links in emails ("Pendaftaran saya").
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ppme-registration",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ppme-registration",
			"database_id": "8f86ce98-349d-4445-8cf5-4b0c9fa55287",
			"migrations_dir": "migrations"
		}
	],

	// Payment deadline job: expiry, reminders, email retries. (Inherited by `test`; `test-admin` turns it off.)
	"triggers": { "crons": ["*/5 * * * *"] },

	"vars": {
		"APP_ENV": "development",
		"DEFAULT_EVENT_SLUG": "kajian-aisah-dahlan-2026",
		"PUBLIC_APP_URL": "http://localhost:5173",
		// Cloudflare test site key: always passes. Replace for production.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		// "log" = store emails in the local outbox (viewable at /admin/outbox); "resend" = send via Resend.
		"EMAIL_MODE": "log",
		"EMAIL_FROM": "Panitia Kajian PPME Den Haag <event@ppmedenhaag.nl>",
		"EMAIL_REPLY_TO": "event@ppmedenhaag.nl",
		// Bank details shown to non-members. Public information (donation account), so plain config, not secrets.
		"BANK_ACCOUNT_NAME": "PPME Den Haag (contoh)",
		"BANK_IBAN": "NL00 TEST 0000 0000 00",
		// One-time seed (comma-separated emails), kept empty in git: set it as a secret (`wrangler secret put ADMIN_EMAILS --env <env>`) or in .dev.vars. Only used to fill the `admins` table while it is empty. After that admins are managed in /admin/admins.
		"ADMIN_EMAILS": "",
		// Optional Google sign-in on /admin/login (needs the GOOGLE_CLIENT_SECRET secret too; empty = PIN only).
		"GOOGLE_CLIENT_ID": ""
	},

	"env": {
		// ---- TEST: public form on workers.dev. Built with CLOUDFLARE_ENV=test (`npm run deploy:test`).
		"test": {
			"name": "ppme-registration",
			// TEMPORARY: served on the free workers.dev address.
			"workers_dev": true,
			// Preview URLs would be extra public hostnames for the same app (and Turnstile would not know them).
			"preview_urls": false,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ppme-registration",
					"database_id": "8f86ce98-349d-4445-8cf5-4b0c9fa55287",
					"migrations_dir": "migrations"
				}
			],
			"vars": {
				"APP_ENV": "production",
				"DEFAULT_EVENT_SLUG": "kajian-aisah-dahlan-2026",
				"PUBLIC_APP_URL": "https://ppme-registration.ppme-registration.workers.dev",
				// The admin lives on its own Worker (`test-admin`): smaller attack surface for the public host.
				"ENABLE_ADMIN": "false",
				"TURNSTILE_SITE_KEY": "0x4AAAAAAF9STdC9uclCsE_i",
				// Public bank account of the association (a donation account), so plain config, not secrets.
				"BANK_ACCOUNT_NAME": "VERENIGING PPME",
				"BANK_IBAN": "NL26 INGB 0002 1661 44",
				"EMAIL_MODE": "resend",
				"EMAIL_FROM": "Panitia Kajian PPME Den Haag <event@ppmedenhaag.nl>",
				"EMAIL_REPLY_TO": "event@ppmedenhaag.nl",
				"ADMIN_EMAILS": "",
				"GOOGLE_CLIENT_ID": ""
			}
		},

		// ---- TEST-ADMIN: /admin only, on its own workers.dev address. Same database as `test`.
		// Every /admin page requires the app's own login (email PIN, or Google once GOOGLE_CLIENT_ID + secret are set).
		// Sends login-code emails, so it needs the RESEND_API_KEY secret.
		"test-admin": {
			"name": "ppme-registration-admin",
			"workers_dev": true,
			"preview_urls": false,
			// The 5-minute job runs on the `test` Worker only.
			"triggers": { "crons": [] },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ppme-registration",
					"database_id": "8f86ce98-349d-4445-8cf5-4b0c9fa55287",
					"migrations_dir": "migrations"
				}
			],
			"vars": {
				"APP_ENV": "production",
				"DEFAULT_EVENT_SLUG": "kajian-aisah-dahlan-2026",
				"PUBLIC_APP_URL": "https://ppme-registration.ppme-registration.workers.dev",
				"ENABLE_PUBLIC": "false",
					// Read-only panitia dashboards (/panitia). Fails closed: only Workers that set this to "true" serve them.
					"ENABLE_VIEWER": "true",
				// Turnstile on the login form (code requests). Same widget as `test`: its hostname list must include this
				// Worker's workers.dev address, and this Worker needs its own TURNSTILE_SECRET secret.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAF9STdC9uclCsE_i",
				"BANK_ACCOUNT_NAME": "VERENIGING PPME",
				"BANK_IBAN": "NL26 INGB 0002 1661 44",
				"EMAIL_MODE": "resend",
				"EMAIL_FROM": "Panitia Kajian PPME Den Haag <event@ppmedenhaag.nl>",
				"EMAIL_REPLY_TO": "event@ppmedenhaag.nl",
				"ADMIN_EMAILS": "",
				// Google sign-in: fill in the OAuth client id and set the GOOGLE_CLIENT_SECRET secret on this Worker.
				// Authorised redirect URI: https://ppme-registration-admin.ppme-registration.workers.dev/admin/auth/google/callback
				"GOOGLE_CLIENT_ID": ""
			}
		},

		// ---- PRODUCTION: public form on https://event.ppmedenhaag.nl (its /admin is 404). Only Worker with the 5-minute cron.
		// The hostname is created by the custom domain (Cloudflare adds the DNS record in the zone). Secrets: TURNSTILE_SECRET, RESEND_API_KEY.
		"production": {
			"name": "ppme-event",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "event.ppmedenhaag.nl", "custom_domain": true }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ppme-registration-prod",
					"database_id": "9f91edd2-862f-47ef-831f-49a1b43fae4e",
					"migrations_dir": "migrations"
				}
			],
			"vars": {
				"APP_ENV": "production",
				"DEFAULT_EVENT_SLUG": "kajian-aisah-dahlan-2026",
				"PUBLIC_APP_URL": "https://event.ppmedenhaag.nl",
				"ENABLE_ADMIN": "false",
				"TURNSTILE_SITE_KEY": "0x4AAAAAAF9STdC9uclCsE_i",
				"BANK_ACCOUNT_NAME": "VERENIGING PPME",
				"BANK_IBAN": "NL26 INGB 0002 1661 44",
				"EMAIL_MODE": "resend",
				"EMAIL_FROM": "Panitia Kajian PPME Den Haag <event@ppmedenhaag.nl>",
				"EMAIL_REPLY_TO": "event@ppmedenhaag.nl",
				"ADMIN_EMAILS": "",
				"GOOGLE_CLIENT_ID": ""
			}
		},

		// ---- PRODUCTION-ADMIN: admin (scanner later) on https://event-admin.ppmedenhaag.nl, app login, same D1 as `production`, no cron.
		// Secrets: TURNSTILE_SECRET, RESEND_API_KEY [+ GOOGLE_CLIENT_SECRET]. Google redirect URI: https://event-admin.ppmedenhaag.nl/admin/auth/google/callback
		"production-admin": {
			"name": "ppme-event-admin",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "event-admin.ppmedenhaag.nl", "custom_domain": true }],
			"triggers": { "crons": [] },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ppme-registration-prod",
					"database_id": "9f91edd2-862f-47ef-831f-49a1b43fae4e",
					"migrations_dir": "migrations"
				}
			],
			"vars": {
				"APP_ENV": "production",
				"DEFAULT_EVENT_SLUG": "kajian-aisah-dahlan-2026",
				"PUBLIC_APP_URL": "https://event.ppmedenhaag.nl",
				"ENABLE_PUBLIC": "false",
					// Read-only panitia dashboards (/panitia). Fails closed: only Workers that set this to "true" serve them.
					"ENABLE_VIEWER": "true",
				"TURNSTILE_SITE_KEY": "0x4AAAAAAF9STdC9uclCsE_i",
				"BANK_ACCOUNT_NAME": "VERENIGING PPME",
				"BANK_IBAN": "NL26 INGB 0002 1661 44",
				"EMAIL_MODE": "resend",
				"EMAIL_FROM": "Panitia Kajian PPME Den Haag <event@ppmedenhaag.nl>",
				"EMAIL_REPLY_TO": "event@ppmedenhaag.nl",
				"ADMIN_EMAILS": "",
				"GOOGLE_CLIENT_ID": ""
			}
		},

		// ---- TEST-CHECKIN: the scanner app (/scan) only, on its own workers.dev address. Same database as `test`.
		// Sends login-code emails (RESEND_API_KEY) and verifies Turnstile (TURNSTILE_SECRET): both are per-Worker secrets.
		"test-checkin": {
			"name": "ppme-registration-checkin",
			"workers_dev": true,
			"preview_urls": false,
			"triggers": { "crons": [] },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ppme-registration",
					"database_id": "8f86ce98-349d-4445-8cf5-4b0c9fa55287",
					"migrations_dir": "migrations"
				}
			],
			"vars": {
				"APP_ENV": "production",
				"DEFAULT_EVENT_SLUG": "kajian-aisah-dahlan-2026",
				"PUBLIC_APP_URL": "https://ppme-registration.ppme-registration.workers.dev",
				// This Worker serves ONLY the check-in app: no public form, no /admin (404s). The scanner app fails closed unless ENABLE_CHECKIN is "true".
				"ENABLE_PUBLIC": "false",
				"ENABLE_ADMIN": "false",
				"ENABLE_CHECKIN": "true",
				// Turnstile on the login form (code requests). The widget's hostname list must include this Worker's hostname.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAF9STdC9uclCsE_i",
				"BANK_ACCOUNT_NAME": "VERENIGING PPME",
				"BANK_IBAN": "NL26 INGB 0002 1661 44",
				"EMAIL_MODE": "resend",
				"EMAIL_FROM": "Panitia Kajian PPME Den Haag <event@ppmedenhaag.nl>",
				"EMAIL_REPLY_TO": "event@ppmedenhaag.nl",
				"ADMIN_EMAILS": "",
				"GOOGLE_CLIENT_ID": ""
			}
		},

		// ---- PRODUCTION-CHECKIN: the scanner app for D-day, same D1 as `production`, no cron.
		// Intended host: https://event-checkin.ppmedenhaag.nl. The custom domain is attached by hand (dashboard: Workers > ppme-event-checkin >
		// Settings > Domains & Routes), NOT by this file, so nothing is exposed before the Turnstile hostname and the secrets are in place.
		// The domain was attached on 14 Nov 2026 and is now kept in config (the route below), so later deploys do not drop it.
		// Secrets (wrangler secret put <NAME> --env production-checkin): TURNSTILE_SECRET, RESEND_API_KEY.
		"production-checkin": {
			"name": "ppme-event-checkin",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "event-checkin.ppmedenhaag.nl", "custom_domain": true }],
			"triggers": { "crons": [] },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ppme-registration-prod",
					"database_id": "9f91edd2-862f-47ef-831f-49a1b43fae4e",
					"migrations_dir": "migrations"
				}
			],
			"vars": {
				"APP_ENV": "production",
				"DEFAULT_EVENT_SLUG": "kajian-aisah-dahlan-2026",
				"PUBLIC_APP_URL": "https://event.ppmedenhaag.nl",
				// This Worker serves ONLY the check-in app: no public form, no /admin (404s). The scanner app fails closed unless ENABLE_CHECKIN is "true".
				"ENABLE_PUBLIC": "false",
				"ENABLE_ADMIN": "false",
				"ENABLE_CHECKIN": "true",
				// Turnstile on the login form (code requests). The widget's hostname list must include this Worker's hostname.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAF9STdC9uclCsE_i",
				"BANK_ACCOUNT_NAME": "VERENIGING PPME",
				"BANK_IBAN": "NL26 INGB 0002 1661 44",
				"EMAIL_MODE": "resend",
				"EMAIL_FROM": "Panitia Kajian PPME Den Haag <event@ppmedenhaag.nl>",
				"EMAIL_REPLY_TO": "event@ppmedenhaag.nl",
				"ADMIN_EMAILS": "",
				"GOOGLE_CLIENT_ID": ""
			}
		}
	}
}
